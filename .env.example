# ============================================================================
# PayPal BusinessPilot AI – environment variables (SAFE TEMPLATE)
# Copy this file to `.env` and fill in values. NEVER commit `.env` or real secrets.
# All variables without NEXT_PUBLIC_ are read on the server only.
# ============================================================================

# --- Database (required) -----------------------------------------------------
# Local PostgreSQL. Change the credentials for any shared environment.
DATABASE_URL=postgresql://postgres:[REDACTED]@127.0.0.1:5432/app_db

# --- App -----------------------------------------------------------------------
# Public origin of the app. Used to build PayPal return/cancel URLs.
# Local default is inferred automatically when this is empty.
APP_URL=http://localhost:3000
# Set to "true" when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false

# --- PayPal Sandbox (optional; enables real sandbox checkout) -------------------
# Create a sandbox app at https://developer.paypal.com/dashboard (Sandbox tab).
# Only sandbox credentials are supported. Never put live credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must stay on the sandbox host (the app refuses any other value).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's webhook settings (enables signature verification).
PAYPAL_WEBHOOK_ID=

# --- AI assistant (optional) ----------------------------------------------------
# Without a key the assistant uses the built-in rules engine, which computes every figure
# from your records. With a key, an OpenAI-compatible model only rephrases those figures.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
